// Database schema. Money and prices are stored as integer paise (₹1 = 100 paise).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Instruments ───────────────────────────────

enum Exchange {
  NSE
  BSE
}

enum InstrumentType {
  EQUITY
  INDEX
}

/// Instrument master: everything that can be quoted or traded.
model Instrument {
  id            Int            @id @default(autoincrement())
  symbol        String
  exchange      Exchange       @default(NSE)
  name          String
  type          InstrumentType @default(EQUITY)
  sector        String?
  lotSize       Int            @default(1)
  tickSizePaise Int            @default(5)
  /// Reference price (previous close) the market simulator starts from.
  /// The simulator writes each day's closing price back here.
  refPricePaise Int
  /// Display-only fundamentals (illustrative). Null when unknown.
  peRatio       Float?
  marketCapCr   Int?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([exchange, symbol])
  @@index([type])
  @@map("instruments")
}

// ─────────────────────────────── Users & auth ───────────────────────────────

enum KycStatus {
  PENDING
  VERIFIED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  fullName         String
  phone            String?
  kycStatus        KycStatus @default(PENDING)
  pan              String?   @unique
  dateOfBirth      DateTime? @db.Date
  kycVerifiedAt    DateTime?
  /// Brute-force protection: consecutive failed logins and lock expiry.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  refreshTokens  RefreshToken[]
  ledgerAccounts LedgerAccount[]
  gtts           Gtt[]
  journalEntries JournalEntry[]
  orders         Order[]
  trades         Trade[]
  holdings       Holding[]

  @@map("users")
}

/// Refresh tokens are stored only as SHA-256 hashes and rotated on every use.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ───────────────────────────── Wallet ledger ─────────────────────────────
// Double-entry bookkeeping: every money movement is a JournalEntry with
// LedgerEntries that sum to zero. Entries are append-only — never updated
// or deleted. LedgerAccount.balancePaise is a cached running total.

enum LedgerAccountType {
  /// A user's cash available to invest or withdraw.
  USER_CASH
  /// A user's cash held back for their open buy orders (can't be spent or withdrawn).
  USER_BLOCKED
  /// The outside world: money entering or leaving Sprout (one shared account).
  SYSTEM_BANK
  /// The market: counterparty for every buy and sell (one shared account).
  SYSTEM_EXCHANGE
  /// Brokerage, taxes and fees collected on trades (one shared account).
  SYSTEM_CHARGES
}

model LedgerAccount {
  id           String            @id @default(uuid())
  type         LedgerAccountType
  userId       String?
  balancePaise BigInt            @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  user    User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@unique([userId, type])
  @@map("ledger_accounts")
}

enum JournalType {
  WELCOME_BONUS
  DEPOSIT
  WITHDRAWAL
  /// Cash → blocked, when a buy order waits for its price
  ORDER_BLOCK
  /// Blocked → cash, when an open buy order is cancelled or expires
  ORDER_RELEASE
  /// Cash (or blocked) → exchange, when a buy executes
  TRADE_BUY
  /// Exchange → cash, when a sell executes
  TRADE_SELL
  /// Cash → charges: brokerage, STT, exchange fee, SEBI fee, stamp duty and GST on a trade
  CHARGES
}

model JournalEntry {
  id             String      @id @default(uuid())
  type           JournalType
  description    String
  userId         String
  /// Client-supplied key so a retried request never moves money twice.
  idempotencyKey String?
  createdAt      DateTime    @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("journal_entries")
}

model LedgerEntry {
  id                String   @id @default(uuid())
  journalId         String
  accountId         String
  /// Signed amount: positive = money into the account, negative = money out.
  amountPaise       BigInt
  balanceAfterPaise BigInt
  createdAt         DateTime @default(now())

  journal JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@map("ledger_entries")
}

// ─────────────────────────── Orders & holdings ───────────────────────────

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  /// Stop-loss: when the price reaches the trigger, a limit order is placed
  SL
  /// Stop-loss market: when the price reaches the trigger, it executes at the market price
  SL_M
}

enum ProductType {
  DELIVERY
  INTRADAY
}

enum OrderStatus {
  /// Stop-loss order waiting for the price to reach its trigger
  TRIGGER_PENDING
  /// Waiting for the price to reach the limit
  OPEN
  EXECUTED
  CANCELLED
  /// Open at the end of the trading day, so the exchange cancelled it
  EXPIRED
  /// Refused by risk checks (funds, holdings, market closed)
  REJECTED
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  symbol            String
  side              OrderSide
  orderType         OrderType
  product           ProductType @default(DELIVERY)
  qty               Int
  limitPricePaise   Int?
  /// SL / SL_M only: the price that activates the order.
  triggerPricePaise Int?
  status            OrderStatus
  /// Money held in the user's USER_BLOCKED account for this waiting buy order (price × qty + charges).
  blockedPaise      BigInt      @default(0)
  fillPricePaise    Int?
  /// Total charges paid when the order executed.
  chargesPaise      BigInt      @default(0)
  /// Why it was rejected, cancelled or expired.
  statusReason      String?
  idempotencyKey    String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  executedAt        DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  trades Trade[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

/// One execution of an order (we fill orders completely, so one trade per executed order).
model Trade {
  id               String    @id @default(uuid())
  orderId          String
  userId           String
  symbol           String
  side             OrderSide
  qty              Int
  pricePaise       Int
  valuePaise       BigInt
  /// For sells: sale value minus the average cost of the shares sold (before charges).
  realizedPnlPaise BigInt?
  chargesPaise     BigInt    @default(0)
  /// Charges split by type: { brokeragePaise, sttPaise, exchangePaise, sebiPaise, stampDutyPaise, gstPaise }
  charges          Json?
  createdAt        DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("trades")
}

/// Shares a user owns. Average price = totalCostPaise / qty.
model Holding {
  id             String   @id @default(uuid())
  userId         String
  symbol         String
  qty            Int      @default(0)
  /// Shares promised to OPEN sell orders (can't be sold twice).
  reservedQty    Int      @default(0)
  totalCostPaise BigInt   @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, symbol])
  @@map("holdings")
}

// ─────────────────────────── GTT (Good Till Triggered) ───────────────────────────

enum GttKind {
  /// One trigger: place a limit order when the price reaches it
  SINGLE
  /// One Cancels Other (sell only): a target above the price and a stop-loss below it
  OCO
}

enum GttStatus {
  ACTIVE
  /// The trigger was hit and the order was placed
  TRIGGERED
  CANCELLED
  /// Not triggered within a year
  EXPIRED
  /// The trigger was hit but the order could not be placed (e.g. limit outside today's price band)
  FAILED
}

/// A standing instruction that lives across days (up to a year). No money or shares are held for it.
model Gtt {
  id                    String    @id @default(uuid())
  userId                String
  symbol                String
  side                  OrderSide
  kind                  GttKind
  qty                   Int
  /// SINGLE: the trigger. OCO: the target (above the price when created).
  triggerPricePaise     Int
  limitPricePaise       Int
  /// OCO only: the stop-loss leg (below the price when created).
  stopTriggerPricePaise Int?
  stopLimitPricePaise   Int?
  /// Decides which way a SINGLE trigger fires (price rising to it, or falling to it).
  ltpAtCreationPaise    Int
  status                GttStatus @default(ACTIVE)
  /// SINGLE, TARGET or STOPLOSS
  triggeredLeg          String?
  orderId               String?
  statusReason          String?
  expiresAt             DateTime
  triggeredAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
  @@map("gtts")
}
