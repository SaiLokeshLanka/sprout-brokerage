# Copy to .env and adjust. Values below match docker-compose.yml (local dev only).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://sprout:sprout@localhost:5432/sprout?schema=public
REDIS_URL=redis://localhost:6379

# Auth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false

# Virtual money credited to every new account (rupees)
WELCOME_BONUS_RUPEES=100000

# Market simulator
#   always = never closes (handy while developing)   nse = real NSE hours, 9:15–15:30 IST, Mon–Fri
MARKET_MODE=always
MARKET_TICK_MS=1000
# Exposes /api/test/market/* so tests can pause the market and set prices. Never enable in production.
ENABLE_TEST_HOOKS=true
