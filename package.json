{
  "name": "sprout",
  "private": true,
  "version": "0.1.0",
  "description": "Sprout — paper-trading brokerage app (React + NestJS + PostgreSQL + Redis)",
  "workspaces": [
    "frontend",
    "backend",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "npm test -w e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "9.1.0",
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.23.1": true,
    "esbuild@0.21.5": true
  }
}
